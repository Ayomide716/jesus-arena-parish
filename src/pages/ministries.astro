---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { church, ministries, url } from "../data/site";
---

<Base
  title={`Ministries — ${church.fullName}`}
  description="Children's church, youth, choir, fellowships, outreach and more — find your place to serve at RCCG Jesus Arena Parish."
>
  <PageHero
    title="Where people serve"
    lede="There is a place for everyone to grow and to serve. Speak to any usher on Sunday, or send us a message, and we will connect you."
    verse="“As every man hath received the gift, even so minister the same one to another.” — 1 Peter 4:10"
  />

  <section class="px-5 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl">
      <div class="border-b border-hairline">
        {
          ministries.map((m) => (
            <div class="index-row grid gap-1 px-2 py-6 sm:grid-cols-[18rem_1fr] sm:gap-10">
              <h2 class="text-lg">{m.name}</h2>
              <p class="measure text-ink-soft">{m.body}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-14 border-t-4 border-green bg-white p-8 sm:p-12">
        <h2 class="text-2xl">Not sure where you fit?</h2>
        <p class="measure mt-4 text-ink-soft">
          That is perfectly normal, and it is not a test. Tell us a little about
          yourself and what you enjoy, and we will point you at a unit where your
          gift is actually needed.
        </p>
        <a href={url("contact")} class="btn btn-green mt-7">Talk to us</a>
      </div>
    </div>
  </section>
</Base>
