---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { church, services } from "../data/site";

const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  church.address.mapsQuery
)}`;

const details = [
  {
    label: "Our address",
    value: `${church.address.line1}<br />${church.address.line2}`,
    href: mapsUrl,
    linkText: "Open in Maps",
    path: "M12 21s-7-4.6-7-10a7 7 0 0 1 14 0c0 5.4-7 10-7 10Z M12 11m-2.5 0a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0-5 0",
  },
  {
    label: "Phone",
    value: church.phone,
    href: church.phoneHref,
    linkText: "Call the parish",
    path: "M6.5 3h3l1.5 4-2 1.4a12.5 12.5 0 0 0 5.6 5.6L16 12l4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.2 2 2 0 0 1 6.5 3Z",
  },
  {
    label: "Email",
    value: church.email,
    href: `mailto:${church.email}`,
    linkText: "Send an email",
    path: "M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z M3.5 7l8.5 6 8.5-6",
  },
  {
    label: "Office hours",
    value: church.officeHours,
    path: "M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0-18 0 M12 7v5l3 2",
  },
];
---

<Base
  title={`Contact — ${church.fullName}`}
  description="Get directions, send a prayer request, or plan your first visit to RCCG Jesus Arena Parish."
>
  <PageHero
    eyebrow="Contact us"
    title="We would love to hear from you"
    lede="A prayer request, a question about the church, or planning your first visit — send us a note and someone will get back to you."
    verse="“Call unto me, and I will answer thee.” — Jeremiah 33:3"
  />

  <section class="px-5 py-20 sm:py-24">
    <div class="mx-auto grid max-w-6xl gap-14 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <h2 class="text-2xl font-semibold text-blue-900">Parish details</h2>

        <ul class="mt-8 space-y-7">
          {
            details.map((d) => (
              <li class="flex gap-4">
                <span
                  class="mt-1 grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-blue-50 text-blue-800"
                  aria-hidden="true"
                >
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d={d.path} />
                  </svg>
                </span>
                <div>
                  <p class="font-semibold text-blue-900">{d.label}</p>
                  <p class="text-muted" set:html={d.value} />
                  {d.href && (
                    <a
                      href={d.href}
                      class="mt-1 inline-block text-sm font-semibold text-blue-800 underline hover:text-scarlet-600"
                    >
                      {d.linkText}
                    </a>
                  )}
                </div>
              </li>
            ))
          }
        </ul>

        <div class="mt-10 rounded-2xl border border-sand-200 bg-white p-7">
          <h3 class="font-display text-lg font-semibold text-blue-900">
            When we gather
          </h3>
          <ul class="mt-4 space-y-2 text-sm text-muted">
            {
              services.map((s) => (
                <li class="flex justify-between gap-4">
                  <span>{s.name}</span>
                  <span class="shrink-0 font-medium text-ink">
                    {s.day} · {s.time}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- Contact form -->
      <div class="card p-9">
        <h2 class="text-2xl font-semibold text-blue-900">Send us a message</h2>
        <p class="mt-2 text-sm text-muted">
          Fields marked with an asterisk are required.
        </p>

        <form id="contact-form" class="mt-8" novalidate>
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="name" class="mb-1.5 block text-sm font-semibold text-blue-900">
                Your name *
              </label>
              <input
                id="name"
                name="name"
                type="text"
                autocomplete="name"
                required
                class="w-full rounded-xl border border-sand-200 bg-sand-50 px-4 py-3 text-[0.95rem] focus:bg-white"
              />
            </div>
            <div>
              <label for="email" class="mb-1.5 block text-sm font-semibold text-blue-900">
                Email address *
              </label>
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                required
                class="w-full rounded-xl border border-sand-200 bg-sand-50 px-4 py-3 text-[0.95rem] focus:bg-white"
              />
            </div>
          </div>

          <div class="mt-5">
            <label for="subject" class="mb-1.5 block text-sm font-semibold text-blue-900">
              How can we help?
            </label>
            <select
              id="subject"
              name="subject"
              class="w-full rounded-xl border border-sand-200 bg-sand-50 px-4 py-3 text-[0.95rem] focus:bg-white"
            >
              <option>Planning my first visit</option>
              <option>Prayer request</option>
              <option>Joining a ministry</option>
              <option>Giving and finance</option>
              <option>General enquiry</option>
            </select>
          </div>

          <div class="mt-5">
            <label for="message" class="mb-1.5 block text-sm font-semibold text-blue-900">
              Message *
            </label>
            <textarea
              id="message"
              name="message"
              rows="6"
              required
              class="w-full rounded-xl border border-sand-200 bg-sand-50 px-4 py-3 text-[0.95rem] focus:bg-white"
            ></textarea>
          </div>

          <button type="submit" class="btn btn-primary mt-7 w-full sm:w-auto">
            Send message
          </button>

          <p id="form-status" role="status" class="mt-4 text-sm text-muted">
            This opens your email app with the message ready to send.
          </p>
        </form>
      </div>
    </div>
  </section>
</Base>

<script is:inline define:vars={{ parishEmail: church.email }}>
  const form = document.getElementById("contact-form");
  const status = document.getElementById("form-status");

  form?.addEventListener("submit", (event) => {
    event.preventDefault();

    const data = new FormData(form);
    const name = String(data.get("name") ?? "").trim();
    const email = String(data.get("email") ?? "").trim();
    const subject = String(data.get("subject") ?? "");
    const message = String(data.get("message") ?? "").trim();

    if (!name || !email || !message) {
      status.textContent =
        "Please fill in your name, your email address and a message.";
      return;
    }

    const body = `Name: ${name}\nEmail: ${email}\n\n${message}\n\n— Sent from the parish website`;

    window.location.href =
      `mailto:${parishEmail}` +
      `?subject=${encodeURIComponent(`${subject} — ${name}`)}` +
      `&body=${encodeURIComponent(body)}`;

    status.textContent =
      "Your email app should now be open with the message ready to send.";
  });
</script>
