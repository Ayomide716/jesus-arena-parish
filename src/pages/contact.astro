---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { church, services } from "../data/site";

const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  church.address.mapsQuery
)}`;

const field =
  "w-full border-2 border-hairline bg-paper px-4 py-3 text-base focus:border-indigo focus:bg-white";
---

<Base
  title={`Contact — ${church.fullName}`}
  description="Get directions, send a prayer request, or plan your first visit to RCCG Jesus Arena Parish."
>
  <PageHero
    title="We would love to hear from you"
    lede="A prayer request, a question about the church, or planning your first visit — send us a note and someone will come back to you."
    verse="“Call unto me, and I will answer thee.” — Jeremiah 33:3"
  />

  <section class="px-5 py-16 sm:py-20">
    <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <div>
        <h2 class="text-2xl sm:text-3xl">Find us</h2>

        <dl class="mt-8">
          <div class="border-t border-hairline py-5 first:border-t-0 first:pt-0">
            <dt class="text-sm text-ink-soft">Address</dt>
            <dd class="mt-1 text-lg">
              {church.address.line1}<br />{church.address.line2}
            </dd>
            <dd class="mt-1">
              <a href={mapsUrl} class="link text-sm">Open in Maps</a>
            </dd>
          </div>

          <div class="border-t border-hairline py-5">
            <dt class="text-sm text-ink-soft">Phone</dt>
            <dd class="mt-1 text-lg">
              <a href={church.phoneHref} class="link">{church.phone}</a>
            </dd>
          </div>

          <div class="border-t border-hairline py-5">
            <dt class="text-sm text-ink-soft">Email</dt>
            <dd class="mt-1 text-lg">
              <a href={`mailto:${church.email}`} class="link">{church.email}</a>
            </dd>
          </div>

          <div class="border-t border-hairline py-5">
            <dt class="text-sm text-ink-soft">Office hours</dt>
            <dd class="mt-1 text-lg">{church.officeHours}</dd>
          </div>
        </dl>

        <h3 class="mt-10 text-lg">When we meet</h3>
        <div class="timetable mt-4">
          {
            services.map((s) => (
              <div class="flex justify-between gap-6 py-3 text-sm">
                <span>{s.name}</span>
                <span
                  class="whitespace-nowrap font-display"
                  style="font-variation-settings: 'wdth' 106, 'wght' 600;"
                >
                  {s.day}, {s.time}
                </span>
              </div>
            ))
          }
        </div>
      </div>

      <div class="border-t-4 border-red bg-white p-8 sm:p-10">
        <h2 class="text-2xl">Send us a note</h2>
        <p class="mt-2 text-sm text-ink-soft">
          Name, email and message are needed. Everything else is optional.
        </p>

        <form id="contact-form" class="mt-8" novalidate>
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="name" class="mb-1.5 block text-sm">Your name</label>
              <input id="name" name="name" type="text" autocomplete="name" required class={field} />
            </div>
            <div>
              <label for="email" class="mb-1.5 block text-sm">Email address</label>
              <input id="email" name="email" type="email" autocomplete="email" required class={field} />
            </div>
          </div>

          <div class="mt-5">
            <label for="subject" class="mb-1.5 block text-sm">What is this about?</label>
            <select id="subject" name="subject" class={field}>
              <option>Planning my first visit</option>
              <option>A prayer request</option>
              <option>Joining a ministry</option>
              <option>Giving and finance</option>
              <option>Something else</option>
            </select>
          </div>

          <div class="mt-5">
            <label for="message" class="mb-1.5 block text-sm">Message</label>
            <textarea id="message" name="message" rows="6" required class={field}></textarea>
          </div>

          <button type="submit" class="btn btn-red mt-7 w-full sm:w-auto">
            Send message
          </button>

          <p id="form-status" role="status" class="mt-4 text-sm text-ink-soft">
            This opens your email app with the message ready to send.
          </p>
        </form>
      </div>
    </div>
  </section>
</Base>

<script is:inline define:vars={{ parishEmail: church.email }}>
  const form = document.getElementById("contact-form");
  const status = document.getElementById("form-status");

  form?.addEventListener("submit", (event) => {
    event.preventDefault();

    const data = new FormData(form);
    const name = String(data.get("name") ?? "").trim();
    const email = String(data.get("email") ?? "").trim();
    const subject = String(data.get("subject") ?? "");
    const message = String(data.get("message") ?? "").trim();

    if (!name || !email || !message) {
      status.textContent =
        "Add your name, your email address and a message, then send again.";
      return;
    }

    const body = `Name: ${name}\nEmail: ${email}\n\n${message}\n\n— Sent from the parish website`;

    window.location.href =
      `mailto:${parishEmail}` +
      `?subject=${encodeURIComponent(`${subject} — ${name}`)}` +
      `&body=${encodeURIComponent(body)}`;

    status.textContent =
      "Your email app should now be open with the message ready to send.";
  });
</script>
