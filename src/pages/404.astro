---
import Base from "../layouts/Base.astro";
import { url } from "../data/site";
---

<Base title="Page not found" description="That page could not be found.">
  <section class="mx-auto max-w-3xl px-5 py-24 text-center sm:py-32">
    <img
      src={url("rccg-emblem-sm.png")}
      alt=""
      width="160"
      height="160"
      class="mx-auto h-24 w-24"
    />
    <h1 class="mt-8 text-[2.2rem] sm:text-[3rem]">
      That page is not here
    </h1>
    <p class="measure mx-auto mt-5 text-lg text-ink-soft">
      The link may be out of date. Head back to the home page, or tell us what
      you were looking for and we will point you at it.
    </p>
    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <a href={url()} class="btn btn-red">Back to the home page</a>
      <a href={url("contact")} class="btn btn-outline">Contact the parish</a>
    </div>
  </section>
</Base>
