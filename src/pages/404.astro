---
import Base from "../layouts/Base.astro";
import { url } from "../data/site";
---

<Base title="Page not found" description="That page could not be found.">
  <section class="mx-auto max-w-3xl px-5 py-28 text-center">
    <p class="eyebrow eyebrow--center justify-center">Error 404</p>
    <h1 class="mt-5 text-4xl font-semibold text-blue-900 sm:text-5xl">
      We could not find that page
    </h1>
    <p class="mx-auto mt-5 max-w-lg text-lg text-muted">
      The link may be out of date. Let us point you back to where you were
      going.
    </p>
    <div class="mt-9 flex flex-wrap justify-center gap-4">
      <a href={url()} class="btn btn-primary">Back to the home page</a>
      <a href={url("contact")} class="btn btn-dark">Contact the parish</a>
    </div>
  </section>
</Base>
