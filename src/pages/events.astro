---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { church, events, services, url } from "../data/site";
---

<Base
  title={`Events — ${church.fullName}`}
  description="Service times, monthly programmes and special gatherings at RCCG Jesus Arena Parish."
>
  <PageHero
    title="Events and gatherings"
    lede="Our week, our month and our year at a glance. All are welcome at every gathering — bring a friend."
    verse="“Not forsaking the assembling of ourselves together.” — Hebrews 10:25"
  />

  <section class="px-5 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl">
      <div class="grid gap-12 lg:grid-cols-[20rem_1fr]">
        <div>
          <h2 class="text-2xl sm:text-3xl">Every week</h2>
          <p class="measure mt-4 text-ink-soft">
            These are the gatherings you can count on, week in and week out.
          </p>
        </div>

        <div class="timetable">
          {
            services.map((s) => (
              <div class="grid gap-1 py-5 sm:grid-cols-[7rem_1fr_auto] sm:gap-6 sm:py-6">
                <p
                  class="font-display text-sm text-green-dark"
                  style="font-variation-settings: 'wdth' 106, 'wght' 650;"
                >
                  {s.day}
                </p>
                <div>
                  <h3 class="text-lg">{s.name}</h3>
                  <p class="measure mt-1 text-sm text-ink-soft">{s.note}</p>
                </div>
                <p
                  class="font-display text-sm whitespace-nowrap sm:text-right"
                  style="font-variation-settings: 'wdth' 106, 'wght' 600;"
                >
                  {s.time}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white px-5 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl">
      <h2 class="text-2xl sm:text-3xl">Through the month and the year</h2>
      <p class="measure mt-4 text-ink-soft">
        The programmes and special services that mark the life of the parish.
      </p>

      <div class="mt-12 grid gap-x-12 gap-y-9 sm:grid-cols-2">
        {
          events.map((e) => (
            <article class="flex gap-5">
              <div
                class="grid h-16 w-16 shrink-0 place-content-center bg-indigo text-center text-white"
                style="border-radius: 3px;"
              >
                <span
                  class="font-display text-[0.62rem] text-indigo-200"
                  style="font-variation-settings: 'wdth' 104, 'wght' 550;"
                >
                  {e.badge.top}
                </span>
                <span
                  class="font-display text-xl leading-none"
                  style="font-variation-settings: 'wdth' 110, 'wght' 700;"
                >
                  {e.badge.main}
                </span>
              </div>
              <div>
                <h3 class="text-lg">{e.title}</h3>
                <p class="mt-0.5 text-sm text-green-dark">
                  {e.when}, in the {e.where.toLowerCase()}
                </p>
                <p class="measure mt-2 text-ink-soft">{e.body}</p>
              </div>
            </article>
          ))
        }
      </div>

      <p class="measure mt-12 text-sm text-ink-soft">
        Dates occasionally change. If you are travelling to join us for a special
        service, <a href={url("contact")} class="link">check with the parish
        office</a> first.
      </p>
    </div>
  </section>
</Base>
