---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { church, giving, url } from "../data/site";
---

<Base
  title={`Giving — ${church.fullName}`}
  description="Give your tithes, offerings and seeds to the work of God at RCCG Jesus Arena Parish."
>
  <PageHero
    title="Partner with the work"
    lede="Your tithes, offerings and seeds keep the lights on, support the work of our ministries and carry the gospel into this community."
    verse="“God loveth a cheerful giver.” — 2 Corinthians 9:7"
  />

  <section class="px-5 py-16 sm:py-20">
    <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
      <div>
        <h2 class="text-2xl sm:text-3xl">Why we give</h2>
        <div class="measure mt-6 space-y-5 text-ink-soft">
          <p>
            Giving is worship. Long before it is a budget line, it is an act of
            trust — saying with our hands what we say with our mouths: that
            everything we have came from God in the first place.
          </p>
          <p>
            What you give sustains the ministry of this parish: the teaching of
            the Word, the care of our children and young people, support for
            members in difficulty, and outreach into the streets around us.
          </p>
          <p>
            You can give in person during any service, or by bank transfer using
            the details here. If you would like a record of your giving for the
            year, the parish office will gladly prepare one.
          </p>
        </div>

        <div class="mt-10 grid gap-8 sm:grid-cols-3">
          <div>
            <span class="seal-rule" aria-hidden="true"></span>
            <h3 class="mt-3 text-lg">Tithe</h3>
            <p class="mt-1 text-sm text-ink-soft">
              The first tenth, returned to God in worship.
            </p>
          </div>
          <div>
            <span class="seal-rule" aria-hidden="true"></span>
            <h3 class="mt-3 text-lg">Offering</h3>
            <p class="mt-1 text-sm text-ink-soft">
              A free gift, given as you purpose in your heart.
            </p>
          </div>
          <div>
            <span class="seal-rule" aria-hidden="true"></span>
            <h3 class="mt-3 text-lg">Projects</h3>
            <p class="mt-1 text-sm text-ink-soft">
              Towards the building and the parish's current needs.
            </p>
          </div>
        </div>
      </div>

      <aside class="h-fit border-t-4 border-green bg-white p-8 sm:p-10">
        <h2 class="text-2xl">Bank transfer</h2>
        <p class="mt-2 text-sm text-ink-soft">
          The quickest way to give from anywhere.
        </p>

        <dl class="mt-8">
          {
            [
              ["Account name", giving.accountName],
              ["Bank", giving.bank],
              ["Account number", giving.accountNumber],
              ["Reference", giving.reference],
            ].map(([term, value]) => (
              <div class="border-t border-hairline py-4 first:border-t-0 first:pt-0">
                <dt class="text-sm text-ink-soft">{term}</dt>
                <dd
                  class="mt-0.5 font-display text-lg"
                  style="font-variation-settings: 'wdth' 108, 'wght' 650;"
                >
                  {value}
                </dd>
              </div>
            ))
          }
        </dl>

        <p class="mt-6 text-sm text-ink-soft">
          Please use the reference so our finance team can record your gift
          correctly.
        </p>
        <a href={url("contact")} class="btn btn-outline mt-6 block text-center">
          Contact the office
        </a>
      </aside>
    </div>

    <p class="measure mx-auto mt-16 text-center text-lg italic">
      “Bring ye all the tithes into the storehouse … and prove me now herewith,
      saith the Lord of hosts, if I will not open you the windows of heaven.”
      <span class="mt-3 block text-sm not-italic text-ink-soft">Malachi 3:10</span>
    </p>
  </section>
</Base>
