---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { church, sermons, socials, url } from "../data/site";

const featured = sermons[0];
const rest = sermons.slice(1);
---

<Base
  title={`Sermons — ${church.fullName}`}
  description="Listen again to recent messages from RCCG Jesus Arena Parish."
>
  <PageHero
    eyebrow="Listen again"
    title="Sermons and teaching"
    lede="Missed a Sunday, or want to hear a message again? Everything we preach is here, and you are welcome to share it."
    verse="“Faith cometh by hearing, and hearing by the word of God.” — Romans 10:17"
  />

  <!-- Featured -->
  <section class="px-5 py-20 sm:py-24">
    <div class="mx-auto max-w-6xl">
      <article
        class="overflow-hidden rounded-3xl bg-blue-950 p-9 text-white sm:p-14"
        style="background-image: radial-gradient(40rem 22rem at 85% 10%, rgba(28,76,184,.5), transparent 62%);"
      >
        <p class="eyebrow !text-scarlet-500">Latest message</p>
        <h2 class="mt-4 max-w-2xl text-3xl font-semibold sm:text-4xl">
          {featured.title}
        </h2>
        <p class="mt-2 text-sm text-blue-100/70">
          {featured.series} · {featured.preacher} · {featured.date}
        </p>
        <p class="mt-5 max-w-2xl text-lg text-blue-100/85">{featured.body}</p>
        <div class="mt-9 flex flex-wrap gap-4">
          <a href={featured.href} class="btn btn-primary">Listen now</a>
          <a href={socials[1].href} class="btn btn-light">Our channel</a>
        </div>
      </article>

      <div class="mt-12 grid gap-7 md:grid-cols-2 lg:grid-cols-3">
        {
          rest.map((s) => (
            <article class="card card-hover flex flex-col p-8">
              <p class="text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-scarlet-600">
                {s.series}
              </p>
              <h2 class="mt-3 text-xl font-semibold text-blue-900">{s.title}</h2>
              <p class="mt-1 text-sm text-muted">
                {s.preacher} · {s.date}
              </p>
              <p class="mt-3 flex-1 leading-relaxed text-muted">{s.body}</p>
              <a
                href={s.href}
                class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-blue-800 hover:text-scarlet-600"
              >
                Listen
                <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>

      <div class="mt-14 rounded-2xl border border-sand-200 bg-white p-9 text-center">
        <h2 class="text-2xl font-semibold text-blue-900">
          Never miss a message
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-muted">
          Subscribe to our channel and you will be notified every time a new
          sermon is posted. You can also join us live on Sunday mornings.
        </p>
        <a href={url("contact")} class="btn btn-dark mt-7">Get in touch</a>
      </div>
    </div>
  </section>
</Base>
