---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { church, sermons, socials, url } from "../data/site";

const [featured, ...rest] = sermons;
---

<Base
  title={`Sermons — ${church.fullName}`}
  description="Listen again to recent messages from RCCG Jesus Arena Parish."
>
  <PageHero
    title="Listen again"
    lede="Missed a Sunday, or want to hear a message a second time? Everything we preach is here, and you are welcome to share it."
    verse="“Faith cometh by hearing, and hearing by the word of God.” — Romans 10:17"
  />

  <section class="px-5 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl">
      <article class="border-t-4 border-red bg-white p-8 sm:p-12">
        <p class="text-sm text-green-dark">The most recent message</p>
        <h2 class="mt-3 max-w-[18ch] text-2xl sm:text-4xl">{featured.title}</h2>
        <p class="measure mt-5 text-lg text-ink-soft">{featured.body}</p>
        <p class="mt-4 text-sm text-ink-soft">
          Preached by {featured.preacher}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={featured.href} class="btn btn-red">Listen now</a>
          <a href={socials[1].href} class="btn btn-outline">Our channel</a>
        </div>
      </article>

      <div class="mt-14 border-b border-hairline">
        {
          rest.map((s) => (
            <div class="index-row grid gap-2 px-2 py-6 sm:grid-cols-[18rem_1fr] sm:gap-10">
              <div>
                <h2 class="text-lg">
                  <a href={s.href} class="hover:text-green-dark">
                    {s.title}
                  </a>
                </h2>
                <p class="mt-0.5 text-sm text-green-dark">{s.series}</p>
              </div>
              <p class="measure text-ink-soft">{s.body}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-14 bg-indigo p-8 text-white sm:p-12">
        <h2 class="measure-tight text-2xl">Never miss a message</h2>
        <p class="measure mt-4 text-indigo-200">
          Subscribe to our channel and you will know as soon as a new sermon goes
          up. You can also join us live on Sunday mornings.
        </p>
        <a href={url("contact")} class="btn btn-outline-light mt-7">
          Get in touch
        </a>
      </div>
    </div>
  </section>
</Base>
