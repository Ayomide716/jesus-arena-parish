---
import Base from "../../layouts/Base.astro";
import { url } from "../../data/site";

/* A struck coin in CSS has no real thickness, so the edge is faked by
   stacking copies of the disc a fraction of a pixel apart along Z. At
   this count the banding disappears and it reads as solid metal. */
const SLICES = 26;
const slices = Array.from({ length: SLICES }, (_, i) => i);
---

<Base
  noindex
  title="Medallion prototype"
  description="A CSS 3D prototype of the parish seal as a struck medallion."
>
  <section class="px-5 py-14">
    <div class="mx-auto max-w-4xl">
      <h1 class="text-3xl sm:text-4xl">The seal as a medallion</h1>
      <p class="measure mt-4 text-ink-soft">
        Two prototypes of the same idea: the emblem given real thickness and
        a surface that catches light. Both are CSS 3D — no WebGL, no Three.js,
        no 3D model. Compare them and tell me which one to keep, or neither.
      </p>
    </div>
  </section>

  <!-- ============ A: no JavaScript ============ -->
  <section class="bg-indigo px-5 py-16 text-white">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-2xl">A. Hover and scroll only</h2>
      <p class="measure mt-3 text-indigo-200">
        Tilts when you point at it, turns slowly as the page scrolls. Costs
        nothing: no JavaScript at all. On a phone, where there is no pointer,
        the scroll turn is what you see.
      </p>

      <div class="stage mt-12">
        <div class="medallion medallion--css">
          {slices.map((i) => (
            <span class="slice" style={`--i:${i}`} aria-hidden="true" />
          ))}
          <img
            class="face"
            src={url("rccg-emblem-480.png")}
            alt="The emblem of the Redeemed Christian Church of God"
            width="480"
            height="480"
            loading="lazy"
            decoding="async"
          />
          <span class="sheen" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ B: pointer-tracked ============ -->
  <section class="bg-indigo-900 px-5 py-16 text-white">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-2xl">B. Follows your pointer</h2>
      <p class="measure mt-3 text-indigo-200">
        The tilt tracks where you point, and the highlight moves with it, so
        the surface behaves like something physical under a light. This one
        needs about fifteen lines of JavaScript — inline, so the rest of the
        site still ships none.
      </p>

      <div class="stage mt-12">
        <div class="medallion medallion--track" id="tracked">
          {slices.map((i) => (
            <span class="slice" style={`--i:${i}`} aria-hidden="true" />
          ))}
          <img
            class="face"
            src={url("rccg-emblem-480.png")}
            alt="The emblem of the Redeemed Christian Church of God"
            width="480"
            height="480"
            loading="lazy"
            decoding="async"
          />
          <span class="sheen sheen--track" aria-hidden="true"></span>
        </div>
      </div>

      <p class="measure mt-10 text-sm text-indigo-200">
        Both respect <code>prefers-reduced-motion</code>: with it on, the
        medallion keeps its depth but stops moving.
      </p>
    </div>
  </section>
</Base>

<style>
  .stage {
    display: grid;
    place-items: center;
    perspective: 1400px;
    padding-block: 2rem;
  }

  .medallion {
    --size: min(22rem, 70vw);
    /* Coin thickness, as a fraction of the diameter. A real medallion is
       roughly a tenth as thick as it is wide. */
    --step: calc(var(--size) / -240);
    position: relative;
    width: var(--size);
    height: var(--size);
    transform-style: preserve-3d;
    will-change: transform;
  }

  /* The stacked edge. Each slice sits a little further back; together
     they read as the milled side of a struck coin. */
  .slice {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: linear-gradient(
      145deg,
      #f4f1fb 0%,
      #cdc5e4 30%,
      #9b93bd 62%,
      #5f568a 100%
    );
    transform: translateZ(calc(var(--i) * var(--step)));
  }

  /* The deepest slice is darkest, so the coin has a shadowed underside
     rather than glowing from behind. */
  .slice:nth-child(n + 17) {
    background: linear-gradient(145deg, #6f6694, #3b3260);
  }

  .face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    transform: translateZ(1px);
    filter: drop-shadow(0 1px 0 rgb(255 255 255 / 0.7));
  }

  /* Specular highlight. Screen blending keeps the emblem's colours
     intact instead of washing them out. */
  /* Lighting. A highlight alone is invisible on a white face — it is the
     shading on the opposite side that gives the disc its volume, plus a
     ring just inside the edge to suggest a struck bevel. */
  .sheen {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    transform: translateZ(2px);
    pointer-events: none;
    background:
      radial-gradient(
        circle at var(--sx, 32%) var(--sy, 24%),
        rgb(255 255 255 / 0.5) 0%,
        rgb(255 255 255 / 0.14) 16%,
        transparent 42%
      ),
      radial-gradient(
        circle at 50% 50%,
        transparent 86%,
        rgb(31 16 89 / 0.28) 95%,
        rgb(255 255 255 / 0.5) 100%
      ),
      linear-gradient(
        150deg,
        rgb(255 255 255 / 0.16) 0%,
        transparent 42%,
        rgb(24 11 69 / 0.26) 82%,
        rgb(24 11 69 / 0.4) 100%
      );
  }

  /* A soft contact shadow on the page beneath the coin. */
  .medallion::after {
    content: "";
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: -8%;
    height: 12%;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgb(8 4 24 / 0.55), transparent 70%);
    transform: translateZ(-40px);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* --- A: hover tilt, no JavaScript --- */
    .medallion--css {
      transform: rotateX(6deg) rotateY(-10deg);
      transition: transform 0.7s cubic-bezier(0.16, 0.84, 0.32, 1);
    }

    .medallion--css:hover {
      transform: rotateX(-10deg) rotateY(28deg);
    }

    /* --- B: pointer-tracked --- */
    .medallion--track {
      transform: rotateX(var(--rx, 4deg)) rotateY(var(--ry, -8deg));
      transition: transform 0.35s cubic-bezier(0.16, 0.84, 0.32, 1);
    }

    .medallion--track.is-tracking {
      transition-duration: 0.08s;
    }
  }

  /* --- A also turns as the page scrolls. Longhands only: the minifier
     folds the `animation` shorthand together with animation-timeline,
     and the shorthand resets the timeline, which kills the effect. --- */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      @keyframes coin-turn {
        from {
          transform: rotateX(8deg) rotateY(-26deg);
        }
        to {
          transform: rotateX(-6deg) rotateY(26deg);
        }
      }

      .medallion--css {
        animation-name: coin-turn;
        animation-duration: 1ms;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 20% exit 80%;
      }

      /* Pointing at it still wins over the scroll position. */
      .medallion--css:hover {
        animation-play-state: paused;
      }
    }
  }
</style>

<script is:inline>
  (() => {
    const el = document.getElementById("tracked");
    if (!el) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const MAX = 16; // degrees — beyond this the emblem starts to distort
    let frame = 0;

    const onMove = (event) => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        const r = el.getBoundingClientRect();
        const clamp = (v) => Math.max(-0.5, Math.min(0.5, v));
        const x = clamp((event.clientX - r.left) / r.width - 0.5);
        const y = clamp((event.clientY - r.top) / r.height - 0.5);
        el.classList.add("is-tracking");
        el.style.setProperty("--ry", `${(x * MAX * 2).toFixed(2)}deg`);
        el.style.setProperty("--rx", `${(-y * MAX * 2).toFixed(2)}deg`);
        el.style.setProperty("--sx", `${(50 + x * 60).toFixed(1)}%`);
        el.style.setProperty("--sy", `${(50 + y * 60).toFixed(1)}%`);
      });
    };

    const reset = () => {
      el.classList.remove("is-tracking");
      el.style.removeProperty("--rx");
      el.style.removeProperty("--ry");
      el.style.setProperty("--sx", "32%");
      el.style.setProperty("--sy", "24%");
    };

    window.addEventListener("pointermove", onMove, { passive: true });
    el.addEventListener("pointerleave", reset);
  })();
</script>
