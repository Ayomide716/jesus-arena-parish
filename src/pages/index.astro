---
import Base from "../layouts/Base.astro";
import { church, events, ministries, sermons, services, url } from "../data/site";

const sunday = services.filter((s) => s.day === "Sunday");
const midweek = services.filter((s) => s.day !== "Sunday");
---

<Base>
  {/* ============ HERO: the seal, at full scale ============ */}
  <section class="relative overflow-hidden bg-indigo text-white">
    {/* The emblem is the one bold thing on this page. On a wide screen it
        runs off the edge at full scale; on a phone it sits above the
        headline as a crest, so it never competes with the words. */}
    <div
      class="pointer-events-none absolute right-[-4rem] top-1/2 hidden w-[42rem] -translate-y-1/2 xl:block"
      aria-hidden="true"
    >
      <div class="seal-parallax">
        <img
          src={url("rccg-emblem.png")}
          alt=""
          width="900"
          height="900"
          class="hero-seal w-full"
        />
      </div>
    </div>

    <div class="relative mx-auto max-w-6xl px-5 py-16 sm:py-20 lg:py-32">
      <div class="xl:max-w-[36rem]">
        <div class="seal-parallax seal-parallax--crest mb-8 xl:hidden" aria-hidden="true">
          <img
            src={url("rccg-emblem-sm.png")}
            alt=""
            width="160"
            height="160"
            class="hero-seal h-24 w-24 sm:h-28 sm:w-28"
          />
        </div>

        <h1
          class="hero-line max-w-[15ch] text-[2.5rem] sm:text-[3.3rem] lg:text-[3.8rem]"
          style="font-variation-settings: 'wdth' 118, 'wght' 800;"
        >
          There is a seat here with your name on it
        </h1>

        <p class="hero-line hero-line-2 measure-tight mt-7 text-lg text-indigo-200">
          {church.fullName} gathers every Sunday to worship, to open the
          Scriptures and to look after one another. Come as you are, and bring
          whoever you like.
        </p>

        <div class="hero-line hero-line-3 mt-9 flex flex-wrap gap-3">
          <a href={url("contact")} class="btn btn-red">Tell us you are coming</a>
          <a href={url("sermons")} class="btn btn-outline-light">Hear a sermon</a>
        </div>
      </div>
    </div>

    {/* The rings, closing the field */}
    <div class="h-[3px] bg-red"></div>
    <div class="h-[2px] bg-green"></div>
  </section>

  {/* ============ THE WEEK: a real timetable ============ */}
  <section class="bg-white px-5 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl">
      <div class="grid gap-12 lg:grid-cols-[20rem_1fr]">
        <div>
          <h2 class="text-2xl sm:text-3xl">Our week</h2>
          <p class="measure mt-4 text-ink-soft">
            Sunday is the heart of it. Midweek we meet to study and to pray, and
            those evenings are smaller and quieter — an easy place to start if a
            full congregation feels like a lot.
          </p>
        </div>

        <div class="timetable">
          {
            [...sunday, ...midweek].map((s) => (
              <div class="grid gap-1 py-5 sm:grid-cols-[7rem_1fr_auto] sm:gap-6 sm:py-6">
                <p
                  class="font-display text-sm text-green-dark"
                  style="font-variation-settings: 'wdth' 106, 'wght' 650;"
                >
                  {s.day}
                </p>
                <div>
                  <h3 class="text-lg">{s.name}</h3>
                  <p class="measure mt-1 text-sm text-ink-soft">{s.note}</p>
                </div>
                <p
                  class="font-display text-sm whitespace-nowrap sm:text-right"
                  style="font-variation-settings: 'wdth' 106, 'wght' 600;"
                >
                  {s.time}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {/* ============ FIRST VISIT ============ */}
  <section class="px-5 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl">
      <h2 class="text-2xl sm:text-3xl">If this would be your first Sunday</h2>

      <div class="mt-10 grid gap-x-12 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        <div>
          <span class="seal-rule" aria-hidden="true"></span>
          <h3 class="mt-4 text-lg">You will not be singled out</h3>
          <p class="measure mt-2 text-ink-soft">
            Nobody will ask you to stand up or introduce yourself. Sit at the
            back if you would rather watch for a week before anyone talks to you.
          </p>
        </div>

        <div>
          <span class="seal-rule" aria-hidden="true"></span>
          <h3 class="mt-4 text-lg">Wear what you own</h3>
          <p class="measure mt-2 text-ink-soft">
            Some of us dress up because that is how we were raised. Others come
            straight from a night shift. Both are right.
          </p>
        </div>

        <div>
          <span class="seal-rule" aria-hidden="true"></span>
          <h3 class="mt-4 text-lg">The children are looked after</h3>
          <p class="measure mt-2 text-ink-soft">
            Children's church and the teens' class run at the same time as the
            main service, so you can listen properly.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ============ THE EMBLEM ============ */}
  <section class="bg-indigo-900 px-5 py-16 text-white sm:py-20">
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[18rem_1fr] lg:gap-16">
      <img
        src={url("rccg-emblem.png")}
        alt="The emblem of the Redeemed Christian Church of God"
        width="900"
        height="900"
        class="seal-reveal mx-auto w-52 lg:mx-0 lg:w-full"
      />

      <div>
        <h2 class="text-2xl sm:text-3xl">Every colour on our seal preaches</h2>
        <p class="measure mt-4 text-indigo-200">
          The emblem of the Redeemed Christian Church of God is not decoration.
          The church gives each part of it a meaning, and those meanings are the
          convictions this parish is built on.
        </p>

        <dl class="mt-9 grid gap-6 sm:grid-cols-2">
          <div class="border-l-4 border-red pl-4">
            <dt class="font-display text-base" style="font-variation-settings: 'wdth' 108, 'wght' 650;">
              The red rings
            </dt>
            <dd class="mt-1 text-indigo-200">
              The blood of Jesus, which covers us
            </dd>
          </div>
          <div class="border-l-4 border-green pl-4">
            <dt class="font-display text-base" style="font-variation-settings: 'wdth' 108, 'wght' 650;">
              The green lettering
            </dt>
            <dd class="mt-1 text-indigo-200">Fruitfulness and increase</dd>
          </div>
          <div class="border-l-4 border-white pl-4">
            <dt class="font-display text-base" style="font-variation-settings: 'wdth' 108, 'wght' 650;">
              The white dove
            </dt>
            <dd class="mt-1 text-indigo-200">
              The Holy Spirit, our senior partner
            </dd>
          </div>
          <div class="border-l-4 border-indigo-600 pl-4">
            <dt class="font-display text-base" style="font-variation-settings: 'wdth' 108, 'wght' 650;">
              The indigo field
            </dt>
            <dd class="mt-1 text-indigo-200">Agape, the love of God</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  {/* ============ MINISTRIES: a parish index ============ */}
  <section class="bg-white px-5 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 class="text-2xl sm:text-3xl">Where people serve</h2>
        <a href={url("ministries")} class="link">All ministries and fellowships</a>
      </div>

      <div class="mt-9 border-b border-hairline">
        {
          ministries.slice(0, 6).map((m) => (
            <div class="index-row grid gap-1 px-2 py-5 sm:grid-cols-[16rem_1fr] sm:gap-8">
              <h3 class="text-lg">{m.name}</h3>
              <p class="measure text-ink-soft">{m.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ============ EVENTS ============ */}
  <section class="px-5 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 class="text-2xl sm:text-3xl">Coming up</h2>
        <a href={url("events")} class="link">The full calendar</a>
      </div>

      <div class="mt-9 grid gap-x-12 gap-y-9 sm:grid-cols-2">
        {
          events.slice(0, 4).map((e) => (
            <article class="flex gap-5">
              <div
                class="grid h-16 w-16 shrink-0 place-content-center bg-indigo text-center text-white"
                style="border-radius: 3px;"
              >
                <span class="font-display text-[0.62rem] text-indigo-200" style="font-variation-settings: 'wdth' 104, 'wght' 550;">
                  {e.badge.top}
                </span>
                <span class="font-display text-xl leading-none" style="font-variation-settings: 'wdth' 110, 'wght' 700;">
                  {e.badge.main}
                </span>
              </div>
              <div>
                <h3 class="text-lg">{e.title}</h3>
                <p class="mt-0.5 text-sm text-green-dark">{e.when}</p>
                <p class="measure mt-2 text-ink-soft">{e.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* ============ SERMONS ============ */}
  <section class="bg-white px-5 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 class="text-2xl sm:text-3xl">Listen again</h2>
        <a href={url("sermons")} class="link">Every sermon</a>
      </div>

      <div class="mt-9 grid gap-x-12 gap-y-8 sm:grid-cols-3">
        {
          sermons.slice(0, 3).map((s) => (
            <article>
              <span class="seal-rule" aria-hidden="true" />
              <h3 class="mt-4 text-lg">
                <a href={s.href} class="hover:text-green-dark">
                  {s.title}
                </a>
              </h3>
              <p class="measure mt-2 text-ink-soft">{s.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* ============ CLOSING ============ */}
  <section class="bg-green-dark px-5 py-16 text-white sm:py-20">
    <div class="mx-auto max-w-6xl">
      <h2 class="measure-tight text-2xl sm:text-3xl">
        Come this Sunday. We will be glad to see you.
      </h2>
      <p class="measure mt-4 text-green-100">
        If you would like someone to meet you at the door, send us a note and we
        will look out for you. If you would rather slip in quietly, that is
        welcome too.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={url("contact")}
          class="btn bg-white text-green-dark hover:bg-indigo-100"
        >
          Send us a note
        </a>
        <a href={url("giving")} class="btn btn-outline-light">Give to the work</a>
      </div>
    </div>
  </section>
</Base>
