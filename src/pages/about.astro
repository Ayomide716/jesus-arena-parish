---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { beliefs, church, pastor, url } from "../data/site";
---

<Base
  title={`About — ${church.fullName}`}
  description="Who we are, what we believe, and the convictions that shape the life of RCCG Jesus Arena Parish."
>
  <PageHero
    title="One family, called to lift Jesus up"
    lede="We are a congregation of the Redeemed Christian Church of God — an ordinary family of believers serving an extraordinary God."
    verse="“That in all things He might have the pre-eminence.” — Colossians 1:18"
  />

  <section class="px-5 py-16 sm:py-20">
    <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
      <div>
        <h2 class="text-2xl sm:text-3xl">A house built by prayer</h2>
        <div class="measure mt-6 space-y-5 text-ink-soft">
          <p>
            {church.fullName} began the way most RCCG parishes begin — with a
            handful of believers, a few chairs, and a conviction that God wanted
            to do something in this community. What has grown from that is a
            church family drawn from many backgrounds and many seasons of life.
          </p>
          <p>
            Our mission is the mission of the Redeemed Christian Church of God:
            to make heaven, to take as many people with us as possible, to hold
            firmly to holiness, and to plant churches within five minutes'
            walking distance in every city and town.
          </p>
          <p>
            In practice that means a parish where the Word is taught plainly,
            where prayer is not an afterthought, where children and young people
            are taken seriously, and where nobody has to carry their burdens on
            their own.
          </p>
        </div>
      </div>

      <aside class="border-t-4 border-red bg-white p-8">
        <p class="text-lg italic leading-relaxed">“{pastor.quote}”</p>
        <p
          class="mt-6 font-display text-base"
          style="font-variation-settings: 'wdth' 108, 'wght' 650;"
        >
          {pastor.name}
        </p>
        <p class="text-sm text-ink-soft">{pastor.role}</p>
        <a href={url("contact")} class="btn btn-outline mt-7 block text-center">
          Say hello
        </a>
      </aside>
    </div>
  </section>

  <section class="bg-white px-5 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl">
      <h2 class="text-2xl sm:text-3xl">What we believe</h2>
      <p class="measure mt-4 text-ink-soft">
        These are not slogans. They shape how we worship, how we teach and how we
        treat one another.
      </p>

      <div class="mt-12 grid gap-x-12 gap-y-9 sm:grid-cols-2 lg:grid-cols-3">
        {
          beliefs.map((b) => (
            <div>
              <span class="seal-rule" aria-hidden="true" />
              <h3 class="mt-4 text-lg">{b.title}</h3>
              <p class="measure mt-2 text-ink-soft">{b.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-indigo-900 px-5 py-16 text-white sm:py-20">
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[18rem_1fr] lg:gap-16">
      <img
        src={url("rccg-emblem.png")}
        alt="The emblem of the Redeemed Christian Church of God"
        width="900"
        height="900"
        class="mx-auto w-52 lg:mx-0 lg:w-full"
      />
      <div>
        <h2 class="text-2xl sm:text-3xl">Every colour on our seal preaches</h2>
        <p class="measure mt-4 text-indigo-200">
          The church gives each part of its emblem a meaning, and those meanings
          are the convictions this parish is built on.
        </p>
        <dl class="mt-9 grid gap-6 sm:grid-cols-2">
          {
            [
              ["The red rings", "The blood of Jesus, which covers us", "border-red"],
              ["The green lettering", "Fruitfulness and increase", "border-green"],
              ["The white dove", "The Holy Spirit, our senior partner", "border-white"],
              ["The indigo field", "Agape, the love of God", "border-indigo-600"],
            ].map(([term, meaning, border]) => (
              <div class:list={["border-l-4 pl-4", border]}>
                <dt
                  class="font-display text-base"
                  style="font-variation-settings: 'wdth' 108, 'wght' 650;"
                >
                  {term}
                </dt>
                <dd class="mt-1 text-indigo-200">{meaning}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>
</Base>
