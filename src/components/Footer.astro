---
import { church, nav, services, socials, url } from "../data/site";

const year = new Date().getFullYear();

const icons: Record<string, string> = {
  facebook:
    "M13.5 21v-8h2.7l.4-3h-3.1V8.2c0-.9.3-1.5 1.6-1.5h1.6V4a22 22 0 0 0-2.4-.1c-2.4 0-4 1.4-4 4.1V10H7.5v3h2.8v8h3.2Z",
  youtube:
    "M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4a2.5 2.5 0 0 0-1.8 1.8A26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8ZM10 15V9l5.2 3L10 15Z",
  instagram:
    "M12 7.6A4.4 4.4 0 1 0 16.4 12 4.4 4.4 0 0 0 12 7.6Zm0 7.2A2.8 2.8 0 1 1 14.8 12 2.8 2.8 0 0 1 12 14.8Zm5.6-7.4a1 1 0 1 1-1-1 1 1 0 0 1 1 1ZM8 3.5h8A4.5 4.5 0 0 1 20.5 8v8a4.5 4.5 0 0 1-4.5 4.5H8A4.5 4.5 0 0 1 3.5 16V8A4.5 4.5 0 0 1 8 3.5Zm0 1.7A2.8 2.8 0 0 0 5.2 8v8A2.8 2.8 0 0 0 8 18.8h8a2.8 2.8 0 0 0 2.8-2.8V8A2.8 2.8 0 0 0 16 5.2Z",
};
---

<footer class="bg-indigo-900 text-indigo-200">
  <div class="h-[2px] bg-green"></div>
  <div class="h-[3px] bg-red"></div>

  <div class="mx-auto max-w-6xl px-5 py-14">
    <div class="grid gap-10 md:grid-cols-[1.5fr_1fr_1fr]">
      <div>
        <div class="flex items-center gap-3">
          <img
            src={url("rccg-emblem-sm.png")}
            alt=""
            width="160"
            height="160"
            class="h-14 w-14"
          />
          <span class="font-display leading-none text-white">
            <span class="block text-lg" style="font-variation-settings: 'wdth' 112, 'wght' 700;">
              {church.name}
            </span>
            <span
              class="mt-1 block text-[0.68rem] text-indigo-200"
              style="font-variation-settings: 'wdth' 105, 'wght' 500; letter-spacing: 0.08em;"
            >
              Redeemed Christian Church of God
            </span>
          </span>
        </div>

        <p class="measure-tight mt-5 text-sm">
          A parish of the Redeemed Christian Church of God. Whatever brought you
          here, you are welcome on Sunday.
        </p>

        <div class="mt-6 flex gap-2.5">
          {
            socials.map((s) => (
              <a
                href={s.href}
                aria-label={s.name}
                class="grid h-10 w-10 place-items-center rounded-sm border-2 border-white/20 text-white/80 hover:border-green hover:text-white"
              >
                <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={icons[s.icon]} />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      <nav aria-label="Footer">
        <h2 class="font-display text-sm text-white" style="font-variation-settings: 'wdth' 108, 'wght' 650;">
          The parish
        </h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="hover:text-white">
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href={url("giving")} class="hover:text-white">Giving</a>
          </li>
        </ul>
      </nav>

      <div>
        <h2 class="font-display text-sm text-white" style="font-variation-settings: 'wdth' 108, 'wght' 650;">
          When we meet
        </h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            services.map((s) => (
              <li>
                <span class="text-white">{s.name}</span>
                <br />
                {s.day}, {s.time}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="mt-12 border-t border-white/10 pt-6 text-xs">
      &copy; {year} {church.fullName}. To God be the glory.
    </p>
  </div>
</footer>
