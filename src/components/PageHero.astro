---
interface Props {
  title: string;
  lede?: string;
  verse?: string;
}

const { title, lede, verse } = Astro.props;
---

<section class="bg-indigo text-white">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:py-20">
    <h1 class="max-w-[20ch] text-[2.2rem] sm:text-[3rem]">{title}</h1>

    {lede && <p class="measure mt-5 text-lg text-indigo-200">{lede}</p>}

    {
      verse && (
        <p class="measure mt-7 border-l-4 border-red pl-4 italic text-indigo-200">
          {verse}
        </p>
      )
    }
  </div>

  <div class="h-[3px] bg-red"></div>
  <div class="h-[2px] bg-green"></div>
</section>
