---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  verse?: string;
}

const { eyebrow, title, lede, verse } = Astro.props;
---

<section
  class="relative overflow-hidden bg-blue-900 text-white"
  style="background-image: radial-gradient(60rem 30rem at 80% -10%, rgba(28,76,184,.55), transparent 60%), radial-gradient(40rem 24rem at 5% 120%, rgba(27,122,75,.35), transparent 60%);"
>
  <div class="mx-auto max-w-6xl px-5 py-16 sm:py-20">
    <p class="eyebrow !text-scarlet-500">{eyebrow}</p>
    <h1 class="mt-4 max-w-3xl text-4xl font-semibold sm:text-5xl">{title}</h1>
    {
      lede && (
        <p class="mt-5 max-w-2xl text-lg text-blue-100/85">{lede}</p>
      )
    }
    {
      verse && (
        <p class="mt-6 max-w-2xl border-l-2 border-scarlet-600 pl-4 font-display text-lg italic text-blue-100/90">
          {verse}
        </p>
      )
    }
  </div>
</section>
