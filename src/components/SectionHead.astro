---
interface Props {
  title: string;
  lede?: string;
  light?: boolean;
}

const { title, lede, light = false } = Astro.props;
---

<div>
  <h2 class="text-2xl sm:text-3xl">{title}</h2>
  {
    lede && (
      <p class:list={["measure mt-4", light ? "text-indigo-200" : "text-ink-soft"]}>
        {lede}
      </p>
    )
  }
</div>
