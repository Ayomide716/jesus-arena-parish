---
import { church, nav, url } from "../data/site";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) =>
  (href.replace(/\/+$/, "") || "/") === path;
---

<header
  class="sticky top-0 z-50 border-b border-white/10 bg-blue-950/90 backdrop-blur-md"
>
  <div class="mx-auto flex max-w-6xl items-center gap-4 px-5 py-3">
    <a
      href={url()}
      class="flex flex-1 items-center gap-3 text-white"
      aria-label={`${church.fullName} — home`}
    >
      <img
        src={url("logo.svg")}
        alt=""
        width="48"
        height="48"
        class="h-11 w-11 shrink-0"
      />
      <span class="leading-tight">
        <span class="block font-display text-[1.05rem] font-semibold tracking-tight">
          {church.name}
        </span>
        <span class="block text-[0.62rem] font-semibold uppercase tracking-[0.22em] text-blue-100/80">
          RCCG
        </span>
      </span>
    </a>

    <button
      type="button"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Open menu"
      class="grid h-11 w-11 place-items-center rounded-xl border border-white/25 text-white md:hidden"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>

    <nav
      id="site-nav"
      aria-label="Primary"
      class="absolute inset-x-0 top-full hidden flex-col gap-1 border-b border-white/10 bg-blue-950 px-5 pb-6 pt-2 md:static md:flex md:flex-row md:items-center md:gap-7 md:border-0 md:bg-transparent md:p-0"
    >
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "border-b border-white/10 py-3 text-[0.93rem] font-medium text-blue-50/90 transition hover:text-white md:border-0 md:py-1",
              isActive(item.href) &&
                "text-white md:border-b-2 md:border-scarlet-600",
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a href={url("giving")} class="btn btn-primary mt-4 md:mt-0 md:px-6 md:py-3">
        Give
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("site-nav");

  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  });

  menu?.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    if (target.tagName === "A" && window.innerWidth < 768) {
      menu.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
      toggle?.setAttribute("aria-label", "Open menu");
    }
  });
</script>
