---
import { church, nav, url } from "../data/site";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) => (href.replace(/\/+$/, "") || "/") === path;
---

<header class="sticky top-0 z-50 bg-indigo-900 text-white">
  <div class="mx-auto flex max-w-6xl items-center gap-5 px-5 py-3">
    <a
      href={url()}
      class="flex flex-1 items-center gap-3"
      aria-label={`${church.fullName}, home`}
    >
      <img
        src={url("rccg-emblem-sm.png")}
        alt=""
        width="160"
        height="160"
        class="h-12 w-12 shrink-0"
      />
      <span class="font-display leading-none">
        <span
          class="block text-[1.15rem]"
          style="font-variation-settings: 'wdth' 112, 'wght' 700;"
        >
          {church.name}
        </span>
        <span
          class="mt-1 block text-[0.68rem] text-indigo-200"
          style="font-variation-settings: 'wdth' 105, 'wght' 500; letter-spacing: 0.08em;"
        >
          Redeemed Christian Church of God
        </span>
      </span>
    </a>

    <button
      type="button"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Open menu"
      class="burger grid h-11 w-11 shrink-0 place-items-center rounded-sm border-2 border-white/30 md:hidden"
    >
      <span class="burger-bars" aria-hidden="true"></span>
    </button>

    <nav
      id="site-nav"
      aria-label="Primary"
      class="nav-panel absolute inset-x-0 top-full hidden flex-col border-t border-white/10 bg-indigo-900 px-5 pb-6 pt-2 shadow-2xl md:static md:flex md:flex-row md:items-center md:gap-6 md:border-0 md:bg-transparent md:p-0 md:shadow-none"
    >
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "font-display",
              /* Mobile: full-width rows with a comfortable tap target */
              "flex min-h-[52px] items-center border-b border-white/10 text-[1.05rem]",
              /* Desktop: a plain inline row */
              "md:min-h-0 md:border-0 md:text-[0.9rem]",
              isActive(item.href)
                ? "border-l-[3px] border-l-red pl-3 text-white md:border-l-0 md:border-b-2 md:border-b-red md:pb-1 md:pl-0"
                : "text-indigo-200 hover:text-white",
            ]}
            style="font-variation-settings: 'wdth' 106, 'wght' 550;"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={url("giving")}
        class="btn btn-red mt-5 block text-center md:mt-0 md:inline-block"
      >
        Give
      </a>
    </nav>
  </div>

  <!-- The emblem's rings, as the edge of the masthead -->
  <div class="h-[3px] bg-red"></div>
  <div class="h-[2px] bg-green"></div>

  <!-- Lifts the masthead off the page once you have scrolled. -->
  <div
    class="header-shadow pointer-events-none absolute inset-x-0 top-full h-6 bg-gradient-to-b from-indigo-900/30 to-transparent opacity-0"
    aria-hidden="true"
  >
  </div>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("site-nav");

  /* The panel is display:none when closed, so it must become a flex
     column when opened — removing `hidden` alone would leave it as a
     block and the links would run together in a row. */
  function setOpen(open: boolean) {
    if (!menu || !toggle) return;
    menu.classList.toggle("hidden", !open);
    menu.classList.toggle("flex", open);
    toggle.classList.toggle("is-open", open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  }

  const isOpen = () => toggle?.getAttribute("aria-expanded") === "true";

  toggle?.addEventListener("click", () => setOpen(!isOpen()));

  menu?.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    if (target.closest("a") && window.innerWidth < 768) setOpen(false);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && isOpen()) {
      setOpen(false);
      toggle?.focus();
    }
  });

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    if (!isOpen()) return;
    if (!menu?.contains(target) && !toggle?.contains(target)) setOpen(false);
  });

  /* Leaving the phone layout resets the panel to its desktop state. */
  window.matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
    if (e.matches) setOpen(false);
  });
</script>
