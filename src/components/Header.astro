---
import { church, nav, url } from "../data/site";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) => (href.replace(/\/+$/, "") || "/") === path;
---

<header class="sticky top-0 z-50 bg-indigo-900 text-white">
  <div class="mx-auto flex max-w-6xl items-center gap-5 px-5 py-3">
    <a
      href={url()}
      class="flex flex-1 items-center gap-3"
      aria-label={`${church.fullName}, home`}
    >
      <img
        src={url("rccg-emblem-sm.png")}
        alt=""
        width="160"
        height="160"
        class="h-12 w-12 shrink-0"
      />
      <span class="font-display leading-none">
        <span
          class="block text-[1.15rem]"
          style="font-variation-settings: 'wdth' 112, 'wght' 700;"
        >
          {church.name}
        </span>
        <span
          class="mt-1 block text-[0.68rem] text-indigo-200"
          style="font-variation-settings: 'wdth' 105, 'wght' 500; letter-spacing: 0.08em;"
        >
          Redeemed Christian Church of God
        </span>
      </span>
    </a>

    <button
      type="button"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Open menu"
      class="grid h-11 w-11 place-items-center rounded-sm border-2 border-white/30 md:hidden"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>

    <nav
      id="site-nav"
      aria-label="Primary"
      class="absolute inset-x-0 top-full hidden flex-col bg-indigo-900 px-5 pb-6 md:static md:flex md:flex-row md:items-center md:gap-6 md:bg-transparent md:p-0"
    >
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "font-display text-[0.95rem] md:text-[0.9rem]",
              "border-b border-white/10 py-3.5 md:border-0 md:py-0",
              isActive(item.href)
                ? "text-white md:border-b-2 md:border-red md:pb-1"
                : "text-indigo-200 hover:text-white",
            ]}
            style="font-variation-settings: 'wdth' 106, 'wght' 550;"
          >
            {item.label}
          </a>
        ))
      }
      <a href={url("giving")} class="btn btn-red mt-5 text-center md:mt-0">
        Give
      </a>
    </nav>
  </div>

  <!-- The emblem's rings, as the edge of the masthead -->
  <div class="h-[3px] bg-red"></div>
  <div class="h-[2px] bg-green"></div>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("site-nav");

  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  });

  menu?.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    if (target.tagName === "A" && window.innerWidth < 768) {
      menu.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
      toggle?.setAttribute("aria-label", "Open menu");
    }
  });
</script>
