---
import "@fontsource-variable/archivo";
import "@fontsource/newsreader/400.css";
import "@fontsource/newsreader/400-italic.css";
import "../styles/global.css";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { church, url } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = `${church.fullName} — ${church.tagline}`,
  description = church.description,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#28166f" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={url("favicon.png")} />
    <link rel="apple-touch-icon" href={url("favicon.png")} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(url("rccg-emblem.png"), canonical)} />
    <meta name="twitter:card" content="summary" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
  </head>

  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only bg-red px-5 py-3 text-white focus:not-sr-only focus:absolute focus:left-0 focus:top-0 focus:z-[100]"
    >
      Skip to content
    </a>

    <Header />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
